# =============================================================================
# Cấu hình Mô hình LLM cho Adaptive Questioning (Pipeline V2.2)
# =============================================================================

# 1. API Keys & Cổng kết nối (OpenRouter hoặc OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# 2. LLM Phỏng Vấn (Student / Generator): Mô hình được tối ưu và dùng lúc phỏng vấn thật
# Ví dụ: qwen/qwen-2.5-7b-instruct, gpt-4o-mini, meta-llama/llama-3.1-8b-instruct...
OPENROUTER_MODEL=qwen/qwen3.7-flash
# OPENAI_MODEL=gpt-4o-mini

# 3. LLM Giám Khảo 1 (Teacher / Evaluator): Dùng ĐỘC LẬP lúc Compile để chấm Topic Drift
# Khuyên dùng mô hình mạnh và suy luận chặt chẽ (gpt-4o, claude-3.5-sonnet, qwen-2.5-72b-instruct...)
AQ_JUDGE_MODEL=openai/gpt-4o
# AQ_JUDGE_API_KEY=your_separate_judge_key_if_different
# AQ_JUDGE_BASE_URL=https://api.openai.com/v1

# 4. Hyperparameters cho Ablation Study (Tùy chọn - Tiền tố AQ_)
# AQ_TAU_PRIOR=2.0
# AQ_CONVERGENCE_PROB_THRESHOLD=0.75
# AQ_CONVERGENCE_TV_THRESHOLD=0.03
# AQ_MAX_SUB_SLOTS=2
# AQ_K_MAX=3
# AQ_T_MAX=10
# AQ_GLOBAL_COMPLETION_THRESHOLD=0.80
