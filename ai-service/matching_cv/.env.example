# Application Settings
PROJECT_NAME="AI Inference Service"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Embedding model used by the analyze pipeline
STAGE3_MODEL_NAME="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"
STAGE3_MODEL_REVISION="4328cf26390c98c5e3c738b4460a05b95f4911f5"

# Device Configuration: "auto" (default: cuda if available, else cpu), "cuda", or "cpu"
DEVICE="auto"

# OpenRouter LLM Configuration
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
