# ============================================================
# Smile Interview AI Service (Python FastAPI) Environment
# ============================================================
APP_NAME="Smile Interview AI Service"
PORT=8000
DEBUG=true

# LLM Providers
# For local runs with Spring Boot, enable admin-managed runtime settings.
# AI_RUNTIME_BACKEND_URL=http://127.0.0.1:8081
# Set APP_AI_RUNTIME_AUTO_PROVISION=true on Spring Boot to create .runtime/ai-runtime.key.
# Set AI_RUNTIME_KEY_FILE on both services when using a different shared path.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Optional fast model for alignment review, opening greeting, and closing farewell (defaults to OPENROUTER_MODEL)
OPENROUTER_FAST_MODEL=qwen/qwen3.7-flash
EVIDENCE_LIVE_CONCURRENCY=6
EVIDENCE_BLUEPRINT_CONCURRENCY=4
MATCHING_CV_DSPY_EXPLICIT_ENABLED=true

# Voice pipeline (all provider requests use OPENROUTER_API_KEY, server-side only)
INTERVIEW_VOICE_ENABLED=true
OPENROUTER_STT_MODEL=openai/gpt-transcribe
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore
OPENROUTER_TTS_FORMAT=pcm
OPENROUTER_TTS_SAMPLE_RATE=24000
# Simli avatar: separate account/key from OpenRouter. Keep key server-side.
SIMLI_API_KEY=
SIMLI_FACE_ID=
SKILL_GAP_CONFIG=config/settings.yaml

# AQ Judge Configuration (Optional)
AQ_JUDGE_BASE_URL=https://openrouter.ai/api/v1
AQ_JUDGE_MODEL=openai/gpt-4o
