# ============================================================
# Smile Interview AI Service (Python FastAPI) Environment
# Copy to ai-service/.env and fill real keys (never commit .env)
# ============================================================
APP_NAME="Smile Interview AI Service"
ENVIRONMENT=production
PORT=8000
DEBUG=false

# Optional comma-separated CORS origins (leave empty when internal-only behind backend)
AI_CORS_ALLOWED_ORIGINS=

# OpenRouter LLM Provider (server-side only)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Optional fast model for alignment review, opening greeting, and closing farewell
OPENROUTER_FAST_MODEL=qwen/qwen3.7-flash
OPENROUTER_REFERER=https://smile-interview.app
EVIDENCE_LIVE_CONCURRENCY=6
EVIDENCE_BLUEPRINT_CONCURRENCY=4
MATCHING_CV_DSPY_EXPLICIT_ENABLED=true

# Voice pipeline (uses OPENROUTER_API_KEY, server-side only)
INTERVIEW_VOICE_ENABLED=true
OPENROUTER_STT_MODEL=openai/gpt-transcribe
OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
OPENROUTER_TTS_VOICE=nadine
OPENROUTER_TTS_FORMAT=pcm
OPENROUTER_TTS_SAMPLE_RATE=44100

# Simli avatar (separate account/key from OpenRouter; keep server-side)
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Optional HuggingFace token for authenticated SBERT downloads
HF_TOKEN=
