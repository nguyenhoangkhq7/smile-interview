# ============================================================
# Smile Interview AI Service (Python FastAPI) Environment
# ============================================================
APP_NAME="Smile Interview AI Service"
PORT=8000
DEBUG=true

# LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Voice pipeline (all provider requests use OPENROUTER_API_KEY, server-side only)
INTERVIEW_VOICE_ENABLED=true
OPENROUTER_STT_MODEL=qwen/qwen3-asr-1.7b
# Free development TTS (OpenRouter lists expiry 2026-11-30); STT/text still billed separately.
OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
OPENROUTER_TTS_VOICE=nadine
OPENROUTER_TTS_FORMAT=pcm
OPENROUTER_TTS_SAMPLE_RATE=44100
# Simli avatar: separate account/key from OpenRouter. Keep key server-side.
SIMLI_API_KEY=
SIMLI_FACE_ID=
SKILL_GAP_CONFIG=config/settings.yaml

# AQ Judge Configuration (Optional)
AQ_JUDGE_BASE_URL=https://openrouter.ai/api/v1
AQ_JUDGE_MODEL=openai/gpt-4o
