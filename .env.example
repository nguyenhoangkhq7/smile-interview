# ============================================================
# Smile Interview Root Docker Compose Environment
# Copy to .env and fill real values (never commit .env)
# ============================================================
POSTGRES_DB=interview_practice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Docker web build. Use the backend URL reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Staging / Production EC2 settings (used by deploy/docker-compose.staging.yml)
APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# GNN_CHECKPOINT_DIR=/absolute/path/to/checkpoints/paper_aligned_gnn
# GNN_REQUIRE_CHECKPOINT=true
BACKUP_S3_BUCKET=smile-interview
BACKUP_S3_PREFIX=backups/postgres
