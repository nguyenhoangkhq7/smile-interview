# ============================================================
# Smile Interview Core Backend (Spring Boot 4 / Java 21)
# Copy to backend/.env and fill real secrets (never commit .env)
# ============================================================
SERVER_PORT=8081

# Database (PostgreSQL 17)
# EC2 Compose builds the RDS URL from the root RDS settings. Set the RDS app role and password below.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interview_practice_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# Security & JWT
# Required for all environments. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# Set to true on staging/production to require rotating V1 seeded admin@smile.com password
APP_SECURITY_REQUIRE_HARDENED_ADMIN=true
# Optional one-time strong password (>= 12 chars) to rotate seeded admin@smile.com on boot
ADMIN_BOOTSTRAP_PASSWORD=

# CORS (comma-separated origins, e.g. https://your-app.vercel.app)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Service (internal Docker network URL on EC2)
FASTAPI_AI_BASE_URL=http://ai-service:8000
FASTAPI_AI_CONNECT_TIMEOUT=15
FASTAPI_AI_READ_TIMEOUT=180

# Amazon S3 (optional in local dev, required for cloud uploads)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=smile-interview
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Web Push (VAPID) — generate with: node scripts/init-web-push.mjs
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.org
